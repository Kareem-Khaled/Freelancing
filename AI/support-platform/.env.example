# Copy to .env and edit. Every value is optional -- defaults live in config.py.
# pydantic-settings loads this file automatically at startup.

# --- Model backend ---
SP_API_BASE=http://localhost:18790/v1
SP_API_KEY=not-needed
SP_MODEL=gemma-4-26b-a4b
SP_TIMEOUT=300
SP_MAX_TOKENS=6144
SP_TEMPERATURE=0.2

# Let the model emit its reasoning block. Off is ~2.5x faster on models that
# honour the flag. Re-verify this whenever you change SP_MODEL.
SP_ENABLE_THINKING=false

# Ask the backend to constrain generation to the JSON schema (structured
# outputs). Guarantees well-formed JSON with correct enum values when the
# server supports it; silently ignored when it does not, which is why the
# client-side parser in textproc.py is kept as a fallback.
SP_USE_STRUCTURED_OUTPUT=true

# --- Reliability ---
SP_MAX_REPAIR_ATTEMPTS=2

# --- Tools (account lookups that ground the analysis) ---
SP_ENABLE_TOOLS=true
SP_MAX_TOOL_ITERATIONS=4

# --- Input guards ---
SP_MAX_MESSAGE_CHARS=8000
SP_MIN_MESSAGE_CHARS=3
SP_MAX_HISTORY_MESSAGES=20

# --- Language ---
# EMPTY BY DEFAULT: every language is handled. The model detects the customer's
# language and writes its draft reply in that same language.
#
# Set this ONLY if your agents can review a limited set of languages. Tickets
# outside the list are still analysed and still get a reply in the customer's
# language -- they are just tagged for someone who can verify it before sending.
#   SP_SUPPORTED_LANGUAGES=en,ar
SP_SUPPORTED_LANGUAGES=

# --- Cost modelling (USD per 1k tokens; local inference is free) ---
SP_COST_PER_1K_INPUT=0.0
SP_COST_PER_1K_OUTPUT=0.0

# --- Storage ---
SP_DB_PATH=support_platform.db
